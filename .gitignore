# 本地运行态 / 密钥
.env
*.log
.DS_Store
run/
agent/run/

# 构建产物（由 build-release.sh 生成，勿提交）
VERSION
EDITION
agent/VERSION
agent/bin/jf-agent-*
images/*.tar.gz
dist/

# 运行时数据
data/*.db
data/*.db-*

# Dashboard 唯一源：仓库根 config/dashboards/（构建时 rsync 到此）
config/dashboards/*.yaml
# 自定义 Dashboard（模板库保留，自定义不入库）
config/dashboards/custom-*.yaml
